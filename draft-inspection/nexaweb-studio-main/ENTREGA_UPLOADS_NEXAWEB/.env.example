# ==============================================================================
# NexaWeb - Arquivo de Configuração de Variáveis de Ambiente (.env)
# ==============================================================================

# Autenticação Administrativa (Painel do Proprietário /admin)
NEXAWEB_ADMIN_PASSWORD=
NEXAWEB_ADMIN_SESSION_SECRET=

# Criptografia de Autorização de Upload Temporário (HMAC-SHA256, 15 min de expiração)
NEXAWEB_UPLOAD_TICKET_SECRET=

# Chave secreta de proteção da rotina de limpeza agendada (Vercel Cron / API Sweeper)
CRON_SECRET=

# Supabase - Conexão Pública (Frontend / Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase - Conexão Privada Server-Side (Vercel Serverless / APIs)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
